# ============================================
# KOBE Corporation — variables d'environnement
# Copier vers .env (ou .env.production) avant le build
# ============================================

# --- Vérification Google Search Console ---
# Search Console → Paramètres → Vérification de la propriété → Balise HTML
# Coller UNIQUEMENT la valeur de content="..."
VITE_GOOGLE_SITE_VERIFICATION=

# --- Vérification Meta (Facebook) Domain ---
# Meta Business Suite → Paramètres de la marque → Domaines → Vérifier
VITE_FACEBOOK_DOMAIN_VERIFICATION=

# --- Vérification Bing Webmaster (optionnel) ---
VITE_BING_SITE_VERIFICATION=

# --- EmailJS (contact / newsletter) ---
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_CONTACT_TEMPLATE_ID=
VITE_EMAILJS_NEWSLETTER_TEMPLATE_ID=
